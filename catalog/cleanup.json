{
  "version": 2,
  "areas": [
    {"id": "xcode", "title": "Xcode build data"},
    {"id": "packages", "title": "Package manager caches"},
    {"id": "browsers", "title": "Browser caches"},
    {"id": "apps", "title": "App caches"},
    {"id": "logs", "title": "Logs and crash reports"},
    {"id": "projects", "title": "Project build output"},
    {"id": "vms", "title": "Containers and virtual machines"},
    {"id": "files", "title": "Backups, downloads and the Trash"}
  ],
  "categories": [
    {"id": "system-cache", "title": "System & App Caches"},
    {"id": "dev-cache", "title": "Developer Caches"},
    {"id": "xcode", "title": "Xcode & iOS"},
    {"id": "project-build", "title": "Project Build Artifacts"},
    {"id": "vms", "title": "VMs & Containers"},
    {"id": "trash", "title": "Trash & Logs"},
    {"id": "other", "title": "Other Large Directories"}
  ],
  "projectRoots": ["~/dev", "~/Projects", "~/Code", "~/workspace"],
  "rules": [
    {"id": "xcode-derived", "kind": "preset", "path": "~/Library/Developer/Xcode/DerivedData", "expandChildren": true, "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Xcode build intermediates.", "recovery": "Regenerated on next build.", "area": "xcode", "rebuildable": true, "processes": ["Xcode", "xcodebuild", "swift", "swiftc", "SourceKitService", "Simulator", "CoreSimulatorService"], "ownerName": "Xcode"},
    {"id": "xcode-devicesupport", "kind": "preset", "path": "~/Library/Developer/Xcode/iOS DeviceSupport", "expandChildren": true, "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Symbols for connected iOS devices.", "recovery": "Re-downloaded when the device connects again.", "area": "xcode", "rebuildable": true, "processes": ["Xcode", "xcodebuild", "swift", "swiftc", "SourceKitService", "Simulator", "CoreSimulatorService"], "ownerName": "Xcode"},
    {"id": "xcode-devicesupport", "kind": "preset", "path": "~/Library/Developer/Xcode/watchOS DeviceSupport", "expandChildren": true, "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Symbols for connected watchOS devices.", "recovery": "Re-downloaded when the device connects again.", "area": "xcode", "rebuildable": true, "processes": ["Xcode", "xcodebuild", "swift", "swiftc", "SourceKitService", "Simulator", "CoreSimulatorService"], "ownerName": "Xcode"},
    {"id": "xcode-devicesupport", "kind": "preset", "path": "~/Library/Developer/Xcode/tvOS DeviceSupport", "expandChildren": true, "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Symbols for connected tvOS devices.", "recovery": "Re-downloaded when the device connects again.", "area": "xcode", "rebuildable": true, "processes": ["Xcode", "xcodebuild", "swift", "swiftc", "SourceKitService", "Simulator", "CoreSimulatorService"], "ownerName": "Xcode"},
    {"id": "xcode-archives", "kind": "preset", "path": "~/Library/Developer/Xcode/Archives", "category": "xcode", "safety": "caution", "owners": ["com.apple.dt.Xcode"], "summary": "App archives (.xcarchive) of shipped builds.", "recovery": "Not regenerable. Needed to re-sign or symbolicate shipped builds.", "area": "xcode", "rebuildable": false, "ownerName": "Xcode"},
    {"id": "coresim-cache", "kind": "preset", "path": "~/Library/Developer/CoreSimulator/Caches", "category": "xcode", "safety": "safe", "owners": ["com.apple.iphonesimulator", "com.apple.dt.Xcode"], "summary": "iOS Simulator caches.", "recovery": "Rebuilt by the Simulator as needed.", "area": "xcode", "rebuildable": true, "processes": ["Xcode", "xcodebuild", "swift", "swiftc", "SourceKitService", "Simulator", "CoreSimulatorService"], "ownerName": "Xcode"},
    {"id": "go-build", "kind": "preset", "path": "~/Library/Caches/go-build", "category": "dev-cache", "safety": "safe", "summary": "Go build cache.", "recovery": "Regenerated on next `go build`.", "area": "packages", "rebuildable": true, "processes": ["go", "gopls"], "ownerName": "Go"},
    {"id": "go-mod-cache", "kind": "preset", "path": "~/go/pkg/mod/cache/download", "category": "dev-cache", "safety": "safe", "summary": "Go module download cache.", "recovery": "Re-downloaded on demand.", "area": "packages", "rebuildable": true, "processes": ["go", "gopls"], "ownerName": "Go"},
    {"id": "cargo-registry", "kind": "preset", "path": "~/.cargo/registry", "category": "dev-cache", "safety": "safe", "summary": "Cargo registry and source cache.", "recovery": "Re-downloaded on next build.", "area": "packages", "rebuildable": true, "processes": ["cargo", "rustc", "rust-analyzer"], "ownerName": "Rust"},
    {"id": "cargo-git", "kind": "preset", "path": "~/.cargo/git", "category": "dev-cache", "safety": "safe", "summary": "Cargo git dependency cache.", "recovery": "Re-cloned on next build.", "area": "packages", "rebuildable": true, "processes": ["cargo", "rustc", "rust-analyzer"], "ownerName": "Rust"},
    {"id": "rustup", "kind": "preset", "path": "~/.rustup/toolchains", "expandChildren": true, "category": "dev-cache", "safety": "review", "summary": "Installed Rust toolchains, one per child.", "recovery": "Removing a toolchain forces rustup to re-install it on next use.", "area": "packages", "rebuildable": true, "ownerName": "Rust"},
    {"id": "npm-cache", "kind": "preset", "path": "~/.npm/_cacache", "category": "dev-cache", "safety": "safe", "summary": "npm content-addressable cache.", "recovery": "Refilled on next `npm install`.", "area": "packages", "rebuildable": true, "processes": ["node", "npm", "pnpm", "yarn", "bun"], "ownerName": "npm"},
    {"id": "pnpm-store", "kind": "preset", "path": "~/Library/pnpm/store", "category": "dev-cache", "safety": "review", "summary": "pnpm content-addressable store, shared across projects.", "recovery": "Rebuilt on `pnpm install`; every project re-downloads its packages.", "area": "packages", "rebuildable": true, "ownerName": "pnpm"},
    {"id": "yarn-cache", "kind": "preset", "path": "~/.yarn/berry/cache", "category": "dev-cache", "safety": "safe", "summary": "Yarn Berry cache.", "recovery": "Refilled on next `yarn install`.", "area": "packages", "rebuildable": true, "processes": ["node", "npm", "pnpm", "yarn", "bun"], "ownerName": "Yarn"},
    {"id": "yarn-cache", "kind": "preset", "path": "~/Library/Caches/Yarn", "category": "dev-cache", "safety": "safe", "summary": "Classic Yarn cache.", "recovery": "Refilled on next `yarn install`.", "area": "packages", "rebuildable": true, "processes": ["node", "npm", "pnpm", "yarn", "bun"], "ownerName": "Yarn"},
    {"id": "gradle-cache", "kind": "preset", "path": "~/.gradle/caches", "category": "dev-cache", "safety": "safe", "summary": "Gradle dependency and build cache.", "recovery": "Re-downloaded and rebuilt on next Gradle run.", "area": "packages", "rebuildable": true, "processes": ["java", "gradle"], "ownerName": "Gradle"},
    {"id": "maven-cache", "kind": "preset", "path": "~/.m2/repository", "category": "dev-cache", "safety": "review", "summary": "Maven local repository.", "recovery": "Re-downloaded on demand; offline builds fail until then.", "area": "packages", "rebuildable": true, "ownerName": "Maven"},
    {"id": "swiftpm-cache", "kind": "preset", "path": "~/Library/Caches/org.swift.swiftpm", "category": "dev-cache", "safety": "safe", "summary": "Swift Package Manager cache.", "recovery": "Re-fetched on next package resolution.", "area": "packages", "rebuildable": true, "processes": ["Xcode", "xcodebuild", "swift", "swiftc", "SourceKitService"], "ownerName": "Swift Package Manager"},
    {"id": "playwright", "kind": "preset", "path": "~/Library/Caches/ms-playwright", "category": "dev-cache", "safety": "safe", "summary": "Playwright browser binaries.", "recovery": "Re-fetched by `npx playwright install`.", "area": "packages", "rebuildable": true, "processes": ["node", "npm", "pnpm", "yarn", "bun", "chrome", "Chromium"], "ownerName": "Playwright"},
    {"id": "cypress", "kind": "preset", "path": "~/Library/Caches/Cypress", "category": "dev-cache", "safety": "safe", "owners": ["com.electron.cypress"], "summary": "Cypress test runner binaries.", "recovery": "Re-downloaded by `npx cypress install`.", "area": "packages", "rebuildable": true, "processes": ["node", "npm", "Cypress"], "ownerName": "Cypress"},
    {"id": "brew-cache", "kind": "preset", "path": "~/Library/Caches/Homebrew", "category": "dev-cache", "safety": "safe", "summary": "Homebrew download cache.", "recovery": "Re-downloaded on next install; `brew cleanup` does the same.", "area": "packages", "rebuildable": true, "processes": ["brew", "ruby"], "ownerName": "Homebrew"},
    {"id": "jetbrains", "kind": "preset", "path": "~/Library/Caches/JetBrains", "category": "dev-cache", "safety": "safe", "owners": ["com.jetbrains.intellij", "com.jetbrains.intellij.ce", "com.jetbrains.goland", "com.jetbrains.pycharm", "com.jetbrains.pycharm.ce", "com.jetbrains.WebStorm", "com.jetbrains.CLion", "com.jetbrains.PhpStorm", "com.jetbrains.rubymine", "com.jetbrains.rider", "com.jetbrains.datagrip", "com.google.android.studio"], "summary": "JetBrains IDE caches (indexes, logs).", "recovery": "Rebuilt on next IDE launch; re-indexing takes a while.", "area": "packages", "rebuildable": true, "processes": ["idea", "pycharm", "goland", "clion", "rider", "webstorm", "java"], "ownerName": "JetBrains"},
    {"id": "codex", "kind": "preset", "path": "~/Library/Caches/com.openai.codex", "category": "dev-cache", "safety": "safe", "summary": "Codex CLI cache.", "recovery": "Rebuilt by the Codex CLI as needed.", "area": "packages", "rebuildable": true, "processes": ["codex", "Codex"], "ownerName": "Codex"},
    {"id": "xdg-cache", "kind": "preset", "path": "~/.cache", "expandChildren": true, "category": "dev-cache", "safety": "review", "summary": "XDG user cache (huggingface, uv, pip, etc.), one child per tool.", "recovery": "Each tool rebuilds or re-downloads its cache on demand.", "area": "packages", "rebuildable": true},
    {"id": "chrome-cache", "kind": "preset", "path": "~/Library/Caches/Google/Chrome", "category": "system-cache", "safety": "safe", "owners": ["com.google.Chrome"], "summary": "Chrome disk cache.", "recovery": "Rebuilt by Chrome as pages load again.", "area": "browsers", "rebuildable": true, "processes": ["Google Chrome", "Google Chrome Helper"], "ownerName": "Chrome"},
    {"id": "chrome-profile-cache", "kind": "preset", "path": "~/Library/Application Support/Google/Chrome/*/Code Cache", "category": "system-cache", "safety": "safe", "owners": ["com.google.Chrome"], "summary": "Chrome script cache of one profile.", "recovery": "Rebuilt by Chrome as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Google Chrome", "Google Chrome Helper"], "ownerName": "Chrome"},
    {"id": "chrome-profile-cache", "kind": "preset", "path": "~/Library/Application Support/Google/Chrome/*/GPUCache", "category": "system-cache", "safety": "safe", "owners": ["com.google.Chrome"], "summary": "Chrome GPU shader cache of one profile.", "recovery": "Rebuilt by Chrome as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Google Chrome", "Google Chrome Helper"], "ownerName": "Chrome"},
    {"id": "chrome-profile-cache", "kind": "preset", "path": "~/Library/Application Support/Google/Chrome/*/Service Worker/CacheStorage", "category": "system-cache", "safety": "safe", "owners": ["com.google.Chrome"], "summary": "Chrome offline site storage of one profile.", "recovery": "Rebuilt by Chrome as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Google Chrome", "Google Chrome Helper"], "ownerName": "Chrome"},
    {"id": "edge-cache", "kind": "preset", "path": "~/Library/Caches/Microsoft Edge", "category": "system-cache", "safety": "safe", "owners": ["com.microsoft.edgemac"], "summary": "Edge disk cache.", "recovery": "Rebuilt by Edge as pages load again.", "area": "browsers", "rebuildable": true, "processes": ["Microsoft Edge", "Microsoft Edge Helper"], "ownerName": "Edge"},
    {"id": "edge-profile-cache", "kind": "preset", "path": "~/Library/Application Support/Microsoft Edge/*/Code Cache", "category": "system-cache", "safety": "safe", "owners": ["com.microsoft.edgemac"], "summary": "Edge script cache of one profile.", "recovery": "Rebuilt by Edge as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Microsoft Edge", "Microsoft Edge Helper"], "ownerName": "Edge"},
    {"id": "edge-profile-cache", "kind": "preset", "path": "~/Library/Application Support/Microsoft Edge/*/GPUCache", "category": "system-cache", "safety": "safe", "owners": ["com.microsoft.edgemac"], "summary": "Edge GPU shader cache of one profile.", "recovery": "Rebuilt by Edge as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Microsoft Edge", "Microsoft Edge Helper"], "ownerName": "Edge"},
    {"id": "edge-profile-cache", "kind": "preset", "path": "~/Library/Application Support/Microsoft Edge/*/Service Worker/CacheStorage", "category": "system-cache", "safety": "safe", "owners": ["com.microsoft.edgemac"], "summary": "Edge offline site storage of one profile.", "recovery": "Rebuilt by Edge as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Microsoft Edge", "Microsoft Edge Helper"], "ownerName": "Edge"},
    {"id": "brave-cache", "kind": "preset", "path": "~/Library/Caches/BraveSoftware/Brave-Browser", "category": "system-cache", "safety": "safe", "owners": ["com.brave.Browser"], "summary": "Brave disk cache.", "recovery": "Rebuilt by Brave as pages load again.", "area": "browsers", "rebuildable": true, "processes": ["Brave Browser", "Brave Browser Helper"], "ownerName": "Brave"},
    {"id": "brave-profile-cache", "kind": "preset", "path": "~/Library/Application Support/BraveSoftware/Brave-Browser/*/Code Cache", "category": "system-cache", "safety": "safe", "owners": ["com.brave.Browser"], "summary": "Brave script cache of one profile.", "recovery": "Rebuilt by Brave as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Brave Browser", "Brave Browser Helper"], "ownerName": "Brave"},
    {"id": "brave-profile-cache", "kind": "preset", "path": "~/Library/Application Support/BraveSoftware/Brave-Browser/*/GPUCache", "category": "system-cache", "safety": "safe", "owners": ["com.brave.Browser"], "summary": "Brave GPU shader cache of one profile.", "recovery": "Rebuilt by Brave as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Brave Browser", "Brave Browser Helper"], "ownerName": "Brave"},
    {"id": "brave-profile-cache", "kind": "preset", "path": "~/Library/Application Support/BraveSoftware/Brave-Browser/*/Service Worker/CacheStorage", "category": "system-cache", "safety": "safe", "owners": ["com.brave.Browser"], "summary": "Brave offline site storage of one profile.", "recovery": "Rebuilt by Brave as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Brave Browser", "Brave Browser Helper"], "ownerName": "Brave"},
    {"id": "arc-cache", "kind": "preset", "path": "~/Library/Caches/Arc", "category": "system-cache", "safety": "safe", "owners": ["company.thebrowser.Browser"], "summary": "Arc disk cache.", "recovery": "Rebuilt by Arc as pages load again.", "area": "browsers", "rebuildable": true, "processes": ["Arc", "Arc Helper"], "ownerName": "Arc"},
    {"id": "arc-profile-cache", "kind": "preset", "path": "~/Library/Application Support/Arc/User Data/*/Code Cache", "category": "system-cache", "safety": "safe", "owners": ["company.thebrowser.Browser"], "summary": "Arc script cache of one profile.", "recovery": "Rebuilt by Arc as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Arc", "Arc Helper"], "ownerName": "Arc"},
    {"id": "arc-profile-cache", "kind": "preset", "path": "~/Library/Application Support/Arc/User Data/*/GPUCache", "category": "system-cache", "safety": "safe", "owners": ["company.thebrowser.Browser"], "summary": "Arc GPU shader cache of one profile.", "recovery": "Rebuilt by Arc as sites load again. Sign-ins, cookies and history are not touched.", "area": "browsers", "rebuildable": true, "processes": ["Arc", "Arc Helper"], "ownerName": "Arc"},
    {"id": "firefox-cache", "kind": "preset", "path": "~/Library/Caches/Firefox/Profiles/*/cache2", "category": "system-cache", "safety": "safe", "owners": ["org.mozilla.firefox"], "summary": "Firefox disk cache of one profile.", "recovery": "Rebuilt by Firefox as pages load again.", "area": "browsers", "rebuildable": true, "processes": ["firefox"], "ownerName": "Firefox"},
    {"id": "safari-cache", "kind": "preset", "path": "~/Library/Caches/com.apple.Safari", "category": "system-cache", "safety": "safe", "owners": ["com.apple.Safari"], "summary": "Safari disk cache.", "recovery": "Rebuilt by Safari as pages load again. Needs Full Disk Access to read.", "area": "browsers", "rebuildable": true, "processes": ["Safari", "com.apple.WebKit.Networking"], "ownerName": "Safari"},
    {"id": "pip-cache", "kind": "preset", "path": "~/Library/Caches/pip", "category": "dev-cache", "safety": "safe", "summary": "pip download and wheel cache.", "recovery": "Refilled on next pip install.", "area": "packages", "rebuildable": true, "processes": ["pip", "pip3", "python", "python3"], "ownerName": "pip"},
    {"id": "poetry-cache", "kind": "preset", "path": "~/Library/Caches/pypoetry", "category": "dev-cache", "safety": "safe", "summary": "Poetry package cache.", "recovery": "Refilled on next poetry install.", "area": "packages", "rebuildable": true, "processes": ["poetry", "python", "python3"], "ownerName": "Poetry"},
    {"id": "cocoapods-cache", "kind": "preset", "path": "~/Library/Caches/CocoaPods", "category": "dev-cache", "safety": "safe", "summary": "CocoaPods download cache.", "recovery": "Refilled on next pod install.", "area": "packages", "rebuildable": true, "processes": ["pod", "ruby"], "ownerName": "CocoaPods"},
    {"id": "bun-cache", "kind": "preset", "path": "~/.bun/install/cache", "category": "dev-cache", "safety": "safe", "summary": "Bun package cache.", "recovery": "Refilled on next bun install.", "area": "packages", "rebuildable": true, "processes": ["bun"], "ownerName": "Bun"},
    {"id": "node-gyp-cache", "kind": "preset", "path": "~/Library/Caches/node-gyp", "category": "dev-cache", "safety": "safe", "summary": "node-gyp header cache.", "recovery": "Re-downloaded on the next native build.", "area": "packages", "rebuildable": true, "processes": ["node", "npm", "node-gyp"], "ownerName": "node-gyp"},
    {"id": "deno-cache", "kind": "preset", "path": "~/Library/Caches/deno", "category": "dev-cache", "safety": "safe", "summary": "Deno module cache.", "recovery": "Re-downloaded on the next run.", "area": "packages", "rebuildable": true, "processes": ["deno"], "ownerName": "Deno"},
    {"id": "composer-cache", "kind": "preset", "path": "~/Library/Caches/composer", "category": "dev-cache", "safety": "safe", "summary": "Composer package cache.", "recovery": "Refilled on next composer install.", "area": "packages", "rebuildable": true, "processes": ["composer", "php"], "ownerName": "Composer"},
    {"id": "terraform-plugins", "kind": "preset", "path": "~/.terraform.d/plugin-cache", "category": "dev-cache", "safety": "safe", "summary": "Terraform provider cache.", "recovery": "Re-downloaded by terraform init.", "area": "packages", "rebuildable": true, "processes": ["terraform"], "ownerName": "Terraform"},
    {"id": "pub-cache", "kind": "preset", "path": "~/.pub-cache", "category": "dev-cache", "safety": "review", "summary": "Dart and Flutter package cache, shared by all projects.", "recovery": "Re-downloaded by pub get; every project downloads its packages again.", "area": "packages", "rebuildable": true, "processes": ["dart", "flutter"], "ownerName": "Dart"},
    {"id": "vscode-cache", "kind": "preset", "path": "~/Library/Application Support/Code/Cache", "category": "dev-cache", "safety": "safe", "owners": ["com.microsoft.VSCode"], "summary": "Visual Studio Code cache.", "recovery": "Rebuilt by VS Code on the next launch. Settings and extensions are not touched.", "area": "packages", "rebuildable": true, "processes": ["Code", "Code Helper", "Electron"], "ownerName": "VS Code"},
    {"id": "vscode-cache", "kind": "preset", "path": "~/Library/Application Support/Code/CachedData", "category": "dev-cache", "safety": "safe", "owners": ["com.microsoft.VSCode"], "summary": "Visual Studio Code cache.", "recovery": "Rebuilt by VS Code on the next launch. Settings and extensions are not touched.", "area": "packages", "rebuildable": true, "processes": ["Code", "Code Helper", "Electron"], "ownerName": "VS Code"},
    {"id": "vscode-cache", "kind": "preset", "path": "~/Library/Application Support/Code/Code Cache", "category": "dev-cache", "safety": "safe", "owners": ["com.microsoft.VSCode"], "summary": "Visual Studio Code cache.", "recovery": "Rebuilt by VS Code on the next launch. Settings and extensions are not touched.", "area": "packages", "rebuildable": true, "processes": ["Code", "Code Helper", "Electron"], "ownerName": "VS Code"},
    {"id": "vscode-cache", "kind": "preset", "path": "~/Library/Application Support/Code/GPUCache", "category": "dev-cache", "safety": "safe", "owners": ["com.microsoft.VSCode"], "summary": "Visual Studio Code cache.", "recovery": "Rebuilt by VS Code on the next launch. Settings and extensions are not touched.", "area": "packages", "rebuildable": true, "processes": ["Code", "Code Helper", "Electron"], "ownerName": "VS Code"},
    {"id": "xcode-doc-cache", "kind": "preset", "path": "~/Library/Developer/Xcode/DocumentationCache", "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Xcode documentation cache.", "recovery": "Rebuilt when you open the documentation.", "area": "xcode", "rebuildable": true, "processes": ["Xcode"], "ownerName": "Xcode"},
    {"id": "xcode-device-logs", "kind": "preset", "path": "~/Library/Developer/Xcode/iOS Device Logs", "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Logs copied from connected devices.", "recovery": "Not rebuilt; only past device logs are lost.", "area": "logs", "rebuildable": true, "processes": ["Xcode"], "ownerName": "Xcode"},
    {"id": "crash-reports", "kind": "preset", "path": "~/Library/Logs/DiagnosticReports", "category": "trash", "safety": "safe", "summary": "Crash and hang reports.", "recovery": "Not rebuilt; only past reports are lost. New reports are written when an app crashes.", "area": "logs", "rebuildable": true, "processes": ["ReportCrash"], "ownerName": "macOS"},
    {"id": "device-firmware", "kind": "preset", "path": "~/Library/iTunes/iPhone Software Updates", "category": "other", "safety": "safe", "summary": "Downloaded iPhone system software.", "recovery": "Downloaded again when a device needs it.", "area": "files", "rebuildable": true, "processes": ["AMPDevicesAgent", "MobileDeviceUpdater"], "ownerName": "Finder device sync"},
    {"id": "device-firmware", "kind": "preset", "path": "~/Library/iTunes/iPad Software Updates", "category": "other", "safety": "safe", "summary": "Downloaded iPad system software.", "recovery": "Downloaded again when a device needs it.", "area": "files", "rebuildable": true, "processes": ["AMPDevicesAgent", "MobileDeviceUpdater"], "ownerName": "Finder device sync"},
    {"id": "ios-backups", "kind": "preset", "path": "~/Library/Application Support/MobileSync/Backup", "expandChildren": true, "category": "other", "safety": "review", "summary": "Backups of iPhone and iPad, one folder for each backup.", "recovery": "Not rebuilt. A backup that is gone cannot restore a device. Keep the newest backup of each device.", "area": "files", "rebuildable": false, "processes": ["AMPDevicesAgent", "MobileDeviceUpdater"], "ownerName": "Finder device sync"},
