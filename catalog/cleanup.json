{
  "version": 1,
  "categories": [
    {"id": "system-cache", "title": "System & App Caches"},
    {"id": "dev-cache", "title": "Developer Caches"},
    {"id": "xcode", "title": "Xcode & iOS"},
    {"id": "project-build", "title": "Project Build Artifacts"},
    {"id": "vms", "title": "VMs & Containers"},
    {"id": "trash", "title": "Trash & Logs"},
    {"id": "other", "title": "Other Large Directories"}
  ],
  "projectRoots": ["~/dev", "~/Projects", "~/Code", "~/workspace"],
  "rules": [
    {"id": "xcode-derived", "kind": "preset", "path": "~/Library/Developer/Xcode/DerivedData", "expandChildren": true, "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Xcode build intermediates.", "recovery": "Regenerated on next build."},
    {"id": "xcode-devicesupport", "kind": "preset", "path": "~/Library/Developer/Xcode/iOS DeviceSupport", "expandChildren": true, "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Symbols for connected iOS devices.", "recovery": "Re-downloaded when the device connects again."},
    {"id": "xcode-devicesupport", "kind": "preset", "path": "~/Library/Developer/Xcode/watchOS DeviceSupport", "expandChildren": true, "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Symbols for connected watchOS devices.", "recovery": "Re-downloaded when the device connects again."},
    {"id": "xcode-devicesupport", "kind": "preset", "path": "~/Library/Developer/Xcode/tvOS DeviceSupport", "expandChildren": true, "category": "xcode", "safety": "safe", "owners": ["com.apple.dt.Xcode"], "summary": "Symbols for connected tvOS devices.", "recovery": "Re-downloaded when the device connects again."},
    {"id": "xcode-archives", "kind": "preset", "path": "~/Library/Developer/Xcode/Archives", "category": "xcode", "safety": "caution", "owners": ["com.apple.dt.Xcode"], "summary": "App archives (.xcarchive) of shipped builds.", "recovery": "Not regenerable. Needed to re-sign or symbolicate shipped builds."},
    {"id": "coresim-cache", "kind": "preset", "path": "~/Library/Developer/CoreSimulator/Caches", "category": "xcode", "safety": "safe", "owners": ["com.apple.iphonesimulator", "com.apple.dt.Xcode"], "summary": "iOS Simulator caches.", "recovery": "Rebuilt by the Simulator as needed."},
    {"id": "go-build", "kind": "preset", "path": "~/Library/Caches/go-build", "category": "dev-cache", "safety": "safe", "summary": "Go build cache.", "recovery": "Regenerated on next `go build`."},
    {"id": "go-mod-cache", "kind": "preset", "path": "~/go/pkg/mod/cache/download", "category": "dev-cache", "safety": "safe", "summary": "Go module download cache.", "recovery": "Re-downloaded on demand."},
    {"id": "cargo-registry", "kind": "preset", "path": "~/.cargo/registry", "category": "dev-cache", "safety": "safe", "summary": "Cargo registry and source cache.", "recovery": "Re-downloaded on next build."},
    {"id": "cargo-git", "kind": "preset", "path": "~/.cargo/git", "category": "dev-cache", "safety": "safe", "summary": "Cargo git dependency cache.", "recovery": "Re-cloned on next build."},
    {"id": "rustup", "kind": "preset", "path": "~/.rustup/toolchains", "expandChildren": true, "category": "dev-cache", "safety": "review", "summary": "Installed Rust toolchains, one per child.", "recovery": "Removing a toolchain forces rustup to re-install it on next use."},
    {"id": "npm-cache", "kind": "preset", "path": "~/.npm/_cacache", "category": "dev-cache", "safety": "safe", "summary": "npm content-addressable cache.", "recovery": "Refilled on next `npm install`."},
    {"id": "pnpm-store", "kind": "preset", "path": "~/Library/pnpm/store", "category": "dev-cache", "safety": "review", "summary": "pnpm content-addressable store, shared across projects.", "recovery": "Rebuilt on `pnpm install`; every project re-downloads its packages."},
    {"id": "yarn-cache", "kind": "preset", "path": "~/.yarn/berry/cache", "category": "dev-cache", "safety": "safe", "summary": "Yarn Berry cache.", "recovery": "Refilled on next `yarn install`."},
    {"id": "yarn-cache", "kind": "preset", "path": "~/Library/Caches/Yarn", "category": "dev-cache", "safety": "safe", "summary": "Classic Yarn cache.", "recovery": "Refilled on next `yarn install`."},
    {"id": "gradle-cache", "kind": "preset", "path": "~/.gradle/caches", "category": "dev-cache", "safety": "safe", "summary": "Gradle dependency and build cache.", "recovery": "Re-downloaded and rebuilt on next Gradle run."},
    {"id": "maven-cache", "kind": "preset", "path": "~/.m2/repository", "category": "dev-cache", "safety": "review", "summary": "Maven local repository.", "recovery": "Re-downloaded on demand; offline builds fail until then."},
    {"id": "swiftpm-cache", "kind": "preset", "path": "~/Library/Caches/org.swift.swiftpm", "category": "dev-cache", "safety": "safe", "summary": "Swift Package Manager cache.", "recovery": "Re-fetched on next package resolution."},
    {"id": "playwright", "kind": "preset", "path": "~/Library/Caches/ms-playwright", "category": "dev-cache", "safety": "safe", "summary": "Playwright browser binaries.", "recovery": "Re-fetched by `npx playwright install`."},
    {"id": "cypress", "kind": "preset", "path": "~/Library/Caches/Cypress", "category": "dev-cache", "safety": "safe", "owners": ["com.electron.cypress"], "summary": "Cypress test runner binaries.", "recovery": "Re-downloaded by `npx cypress install`."},
    {"id": "brew-cache", "kind": "preset", "path": "~/Library/Caches/Homebrew", "category": "dev-cache", "safety": "safe", "summary": "Homebrew download cache.", "recovery": "Re-downloaded on next install; `brew cleanup` does the same."},
    {"id": "jetbrains", "kind": "preset", "path": "~/Library/Caches/JetBrains", "category": "dev-cache", "safety": "safe", "owners": ["com.jetbrains.intellij", "com.jetbrains.intellij.ce", "com.jetbrains.goland", "com.jetbrains.pycharm", "com.jetbrains.pycharm.ce", "com.jetbrains.WebStorm", "com.jetbrains.CLion", "com.jetbrains.PhpStorm", "com.jetbrains.rubymine", "com.jetbrains.rider", "com.jetbrains.datagrip", "com.google.android.studio"], "summary": "JetBrains IDE caches (indexes, logs).", "recovery": "Rebuilt on next IDE launch; re-indexing takes a while."},
    {"id": "codex", "kind": "preset", "path": "~/Library/Caches/com.openai.codex", "category": "dev-cache", "safety": "safe", "summary": "Codex CLI cache.", "recovery": "Rebuilt by the Codex CLI as needed."},
    {"id": "xdg-cache", "kind": "preset", "path": "~/.cache", "expandChildren": true, "category": "dev-cache", "safety": "review", "summary": "XDG user cache (huggingface, uv, pip, etc.), one child per tool.", "recovery": "Each tool rebuilds or re-downloads its cache on demand."},
    {"id": "library-caches", "kind": "preset", "path": "~/Library/Caches", "expandChildren": true, "category": "system-cache", "safety": "safe", "summary": "Per-application caches, one child per app.", "recovery": "Apps rebuild their caches as needed."},
    {"id": "library-logs", "kind": "preset", "path": "~/Library/Logs", "expandChildren": true, "category": "trash", "safety": "safe", "summary": "Per-application logs, one child per app.", "recovery": "Not regenerable; only past diagnostics are lost. Apps start new logs."},
    {"id": "containers", "kind": "preset", "path": "~/Library/Containers", "expandChildren": true, "category": "system-cache", "safety": "caution", "summary": "Sandboxed app containers. Each holds an app's state.", "recovery": "Not regenerable. Remove only containers of apps you no longer use; the app starts fresh."},
    {"id": "orbstack", "kind": "preset", "path": "~/Library/Group Containers/HUAQ24HBR6.dev.orbstack/data", "category": "vms", "safety": "caution", "owners": ["dev.kdrag0n.MacVirt"], "summary": "OrbStack VM and container data.", "recovery": "Not regenerable. Use the OrbStack UI to remove individual containers first."},
    {"id": "apple-container", "kind": "preset", "path": "~/Library/Application Support/com.apple.container", "category": "vms", "safety": "caution", "summary": "Apple Container framework data.", "recovery": "Not regenerable. Images and containers are re-created on demand."},
    {"id": "claude-vm", "kind": "preset", "path": "~/Library/Application Support/Claude/vm_bundles", "category": "vms", "safety": "caution", "owners": ["com.anthropic.claudefordesktop"], "summary": "Claude desktop VM bundles.", "recovery": "Re-downloaded by Claude when a VM feature is used again."},
    {"id": "docker", "kind": "preset", "path": "~/.docker", "category": "vms", "safety": "caution", "owners": ["com.docker.docker"], "summary": "Docker configuration and runtime data.", "recovery": "Not regenerable. Inspect storage in Docker Desktop first; images are re-pulled on demand."},
    {"id": "trash", "kind": "preset", "path": "~/.Trash", "category": "trash", "safety": "review", "summary": "Files already in the Trash.", "recovery": "Not recoverable once removed from the Trash."},
    {"id": "downloads", "kind": "preset", "path": "~/Downloads", "category": "other", "safety": "caution", "summary": "Downloads folder.", "recovery": "Not regenerable. Review every file before deleting."},
    {"id": "artifact:node_modules", "kind": "artifact", "name": "node_modules", "category": "project-build", "safety": "review", "summary": "Node.js dependencies.", "recovery": "Restored by `npm/pnpm/yarn install`."},
    {"id": "artifact:target", "kind": "artifact", "name": "target", "category": "project-build", "safety": "review", "summary": "Rust build output.", "recovery": "Rebuilt by `cargo build`."},
    {"id": "artifact:build", "kind": "artifact", "name": "build", "category": "project-build", "safety": "review", "summary": "Generic build output.", "recovery": "Rebuilt by the project's build tool."},
    {"id": "artifact:.build", "kind": "artifact", "name": ".build", "category": "project-build", "safety": "review", "summary": "Swift Package Manager build output.", "recovery": "Rebuilt by `swift build`."},
    {"id": "artifact:dist", "kind": "artifact", "name": "dist", "category": "project-build", "safety": "review", "summary": "Dist/output folder (frontend bundles, etc.).", "recovery": "Rebuilt by the project's build step."},
    {"id": "artifact:.next", "kind": "artifact", "name": ".next", "category": "project-build", "safety": "review", "summary": "Next.js build cache.", "recovery": "Rebuilt by `next build`."},
    {"id": "artifact:.nuxt", "kind": "artifact", "name": ".nuxt", "category": "project-build", "safety": "review", "summary": "Nuxt build cache.", "recovery": "Rebuilt by `nuxt build`."},
    {"id": "artifact:.turbo", "kind": "artifact", "name": ".turbo", "category": "project-build", "safety": "review", "summary": "Turborepo cache.", "recovery": "Rebuilt on next `turbo` run."},
    {"id": "artifact:.parcel-cache", "kind": "artifact", "name": ".parcel-cache", "category": "project-build", "safety": "review", "summary": "Parcel bundler cache.", "recovery": "Rebuilt on next Parcel build."},
    {"id": "artifact:.gradle", "kind": "artifact", "name": ".gradle", "category": "project-build", "safety": "review", "summary": "Per-project Gradle cache.", "recovery": "Rebuilt on next Gradle run."},
    {"id": "artifact:.dart_tool", "kind": "artifact", "name": ".dart_tool", "category": "project-build", "safety": "review", "summary": "Dart/Flutter tool cache.", "recovery": "Rebuilt by `dart pub get` or `flutter pub get`."},
    {"id": "artifact:DerivedData", "kind": "artifact", "name": "DerivedData", "category": "project-build", "safety": "review", "summary": "Per-project Xcode DerivedData.", "recovery": "Regenerated on next build."},
    {"id": "artifact:Pods", "kind": "artifact", "name": "Pods", "category": "project-build", "safety": "review", "summary": "CocoaPods install.", "recovery": "Restored by `pod install`."},
    {"id": "artifact:__pycache__", "kind": "artifact", "name": "__pycache__", "category": "project-build", "safety": "safe", "summary": "Python bytecode cache.", "recovery": "Regenerated on next import."},
    {"id": "artifact:.pytest_cache", "kind": "artifact", "name": ".pytest_cache", "category": "project-build", "safety": "safe", "summary": "pytest cache.", "recovery": "Regenerated on next test run."},
    {"id": "artifact:.mypy_cache", "kind": "artifact", "name": ".mypy_cache", "category": "project-build", "safety": "safe", "summary": "mypy cache.", "recovery": "Regenerated on next mypy run."},
    {"id": "artifact:.ruff_cache", "kind": "artifact", "name": ".ruff_cache", "category": "project-build", "safety": "safe", "summary": "ruff cache.", "recovery": "Regenerated on next ruff run."},
    {"id": "artifact:.venv", "kind": "artifact", "name": ".venv", "category": "project-build", "safety": "review", "summary": "Python virtualenv.", "recovery": "Recreated by `python -m venv` plus reinstalling dependencies."},
    {"id": "artifact:venv", "kind": "artifact", "name": "venv", "category": "project-build", "safety": "review", "summary": "Python virtualenv.", "recovery": "Recreated by `python -m venv` plus reinstalling dependencies."}
  ]
}
